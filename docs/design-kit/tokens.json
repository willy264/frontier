{
  "$description": "FRONTIER project token mirror. Values match apps/game/app/globals.css as reviewed on 2026-11-13. The copied core/tokens files remain the intact generic kit examples.",
  "$extensions": {
    "com.frontier": {
      "source": "apps/game/app/globals.css",
      "theme": "dark nautical",
      "implementation": "plain CSS custom properties",
      "frameworkMigration": false
    }
  },
  "color": {
    "$type": "color",
    "canvas": { "$value": "#091d29" },
    "surface": { "$value": "#102b3a" },
    "raised": { "$value": "#183746" },
    "ink": { "$value": "#eee8d9" },
    "muted": { "$value": "#adbfca" },
    "accent": { "$value": "#e9b75e" },
    "danger": { "$value": "#ff9790" },
    "hashpower": { "$value": "{color.accent}" },
    "liquidity": { "$value": "#80d1da" },
    "blockspace": { "$value": "#a8bffa" },
    "line": {
      "$value": "#35515f",
      "$description": "Structural separator only. It does not meet 3:1 against project surfaces."
    },
    "line-strong": {
      "$value": "#728d9b",
      "$description": "Meaningful control and input boundary; at least 3.58:1 against all project surfaces."
    },
    "accent-wash": {
      "$value": "color-mix(in srgb, {color.accent} 10%, {color.canvas})",
      "$description": "Background tint only; never text."
    },
    "danger-wash": {
      "$value": "color-mix(in srgb, {color.danger} 10%, {color.canvas})",
      "$description": "Background tint only; never text."
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": ["var(--font-frontier-body)", "system-ui", "sans-serif"]
      },
      "display": {
        "$value": ["var(--font-frontier-display)", "Impact", "sans-serif"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "display-semibold": { "$value": 600 },
      "display-bold": { "$value": 700 },
      "body-range": {
        "$value": "100 1000",
        "$description": "Variable range loaded by next/font/local."
      }
    }
  },
  "text": {
    "$type": "dimension",
    "xs": { "$value": "0.75rem" },
    "sm": { "$value": "0.875rem" },
    "base": { "$value": "1rem" },
    "lg": { "$value": "1.125rem" },
    "card": { "$value": "1.75rem" },
    "section": { "$value": "2.25rem" },
    "display": {
      "$value": "clamp(2.75rem, 4.2vw, 4.5rem)",
      "$description": "CSS fluid value. Font size does not scale below its fixed minimum."
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "0" },
    "card": { "$value": "0" },
    "panel": { "$value": "0" }
  },
  "layout": {
    "$type": "dimension",
    "gutter": { "$value": "24px" },
    "gutter-mobile": { "$value": "16px" },
    "section-y": { "$value": "48px" },
    "measure": { "$value": "45rem" }
  },
  "duration": {
    "$type": "duration",
    "instant": { "$value": "100ms" },
    "fast": { "$value": "180ms" },
    "base": { "$value": "260ms" },
    "showpiece": {
      "$value": "420ms",
      "$description": "Event-toast entrance only. The map itself has no orchestrated animation."
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "game": { "$value": [0.65, 0, 0.35, 1] },
    "game-emphasis": { "$value": [0.85, 0, 0.15, 1] }
  },
  "component": {
    "target": {
      "$type": "dimension",
      "default": { "$value": "44px" },
      "primary": { "$value": "48px" }
    },
    "focus-ring": {
      "width": { "$type": "dimension", "$value": "3px" },
      "offset": { "$type": "dimension", "$value": "3px" },
      "color": { "$type": "color", "$value": "{color.accent}" }
    }
  }
}
